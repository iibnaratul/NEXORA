# NEXORA — copy to .env and fill in real values. NEVER commit a real .env.
# All values below are placeholders or dev-only defaults.

# Required in production (the server refuses to boot without it — see
# docs/DEPLOYMENT.md §1). The value below is a dev placeholder, not a secret.
DATABASE_URL=postgres://nexora:changeme@localhost:5432/nexora

# Server
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
# Comma-separated allowlist, e.g. https://app.example.com. REQUIRED in
# practice for production: with CORS_ORIGINS empty the server reflects any
# request Origin with credentials (see docs/DEPLOYMENT.md finding F-1).
CORS_ORIGINS=

# Sessions (days). There is no session signing secret: sessions are opaque
# random tokens hashed server-side. Rotate by revoking rows in user_sessions
# (see docs/DEPLOYMENT.md §1); shortening the TTL affects new sessions only.
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=nx_session

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=12

# 64 hex chars (32 bytes). REQUIRED in production; dev generates an ephemeral
# key (codes then don't survive restarts — by design).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_ENCRYPTION_KEY=

# Handover-code lifetime (hours) and max attempts
CODE_TTL_HOURS=24
CODE_MAX_ATTEMPTS=5

# Private file storage (local directory; S3 provider is documented, not wired)
STORAGE_DIR=./storage
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=10

# Maps/geocoding provider. Empty = none configured (route endpoint returns 503).
MAPS_PROVIDER=
# OSM stack (OSRM routing + Nominatim geocoding) — needs NO API key.
# MAPS_PROVIDER=osrm
# Self-host overrides (defaults are the public demo servers — see docs/MAPS.md
# for their ~1 req/s limits and why they are not a production backend).
# MAPS_ROUTE_BASE_URL=https://router.project-osrm.org
# MAPS_GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
# Per-request provider timeout in ms (default 5000, clamped 100–30000).
# MAPS_TIMEOUT_MS=5000
# OSRM profile used in the route URL (default driving).
# MAPS_PROFILE=driving

# Rate-limit overrides (defaults: auth 10/min, messages 30/min, uploads 20/min,
# deliveries 60/hour, api 300/min). Only used to relax limits in tests.
# AUTH_RATE_LIMIT_MAX=
# MESSAGE_RATE_LIMIT_MAX=
# UPLOAD_RATE_LIMIT_MAX=
# DELIVERY_RATE_LIMIT_MAX=
# API_RATE_LIMIT_MAX=
